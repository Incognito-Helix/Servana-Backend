// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String    @unique // always stored lowercase, enforced in the service
  passwordHash    String? // null for Google accounts
  googleId        String?   @unique // null for email and password accounts
  role            Role
  phoneNumber     String? // optional for customers, vendors use the phone on their profile
  emailVerified   Boolean   @default(false)
  status          Status    @default(active)
  termsVersion    String? // null only for the seeded admin
  termsAcceptedAt DateTime? // null only for the seeded admin
  createdAt       DateTime  @default(now())
  zoneId          String?
  zone            Zone?     @relation(fields: [zoneId], references: [id])

  // FUTURE (Zone model): zoneId String? and zone Zone? relation, the customer's saved search location
  // FUTURE (Auth step): authTokens AuthToken[], hashed email OTPs and password reset tokens
  // FUTURE (Auth step): recentLocations UserRecentLocation[], last 3 locations per customer
  // FUTURE (Vendor step): vendorProfile VendorProfile?, one profile per vendor
  // FUTURE (Reviews step): reviews Review[], written by customers
  // FUTURE (Contact step): contactReveals ContactReveal[]
  // FUTURE (Payments step): payments Payment[]
  // FUTURE (Dashboard step): profileEvents ProfileEvent[], viewerId is nullable for visitors
  // FUTURE (Admin step): auditLogs AuditLog[], only for admin users
  // FUTURE (PRD 13.1): NGO affiliation tables will link here
  authTokens          AuthToken[]
  userRecentLocations UserRecentLocation[]
  vendorProfile       VendorProfile?

  @@map("users")
}

enum Role {
  customer
  vendor
  admin
}

enum Status {
  active
  suspended
}

model Zone {
  id                   String  @id @default(uuid())
  state                String
  city                 String
  name                 String
  slug                 String  @unique
  centerLatitude       Float
  centerLongitude      Float
  isActive             Boolean @default(true)
  boostPriceMultiplier Decimal @default(1.0) @db.Decimal(4, 2)

  users               User[]
  userRecentLocations UserRecentLocation[]
  vendorProfile       VendorProfile[]

  @@map("zones")
}

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  icon     String?
  isActive Boolean @default(true)
  parentId String?

  parent           Category?        @relation("categoryTree", fields: [parentId], references: [id])
  children         Category[]       @relation("categoryTree")
  vendorCategories VendorCategory[]

  @@map("categories")
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
  @@map("auth_tokens")
}

enum TokenType {
  email_otp
  password_reset
}

model UserRecentLocation {
  id     String   @id @default(uuid())
  userId String
  zoneId String
  usedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone Zone @relation(fields: [zoneId], references: [id])

  @@unique([userId, zoneId])
  @@map("user_recent_locations")
}

enum ProfileStatus {
  draft
  pending
  approved
  rejected
  suspended
}

enum SocialPlatform {
  instagram
  tiktok
  x
  facebook
  other
}

enum VerificationStatus {
  pending
  passed
  failed
}

model VendorProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  slug              String        @unique
  businessName      String
  about             String?
  phone             String?       @unique
  whatsapp          String?
  state             String?
  city              String?
  zoneId            String?
  latitude          Float?
  longitude         Float?
  streetAddress     String?
  offersHomeService Boolean       @default(false)
  serviceRadiusKm   Int?
  worksRemotely     Boolean       @default(false)
  coverImageUrl     String?
  profileImageUrl   String?
  onboardingStep    Int           @default(1)
  status            ProfileStatus @default(draft)
  rejectionReason   String?
  isVerified        Boolean       @default(false)
  avgRating         Decimal       @default(0.0) @db.Decimal(3, 2)
  reviewCount       Int           @default(0)
  locationChangedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone            Zone?            @relation(fields: [zoneId], references: [id])
  categories      VendorCategory[]
  socialLinks     SocialLink[]
  verifications   Verification[]
  services        Service[]
  portfolioImages PortfolioImage[]
  workingHours    WorkingHours[]

  @@index([latitude, longitude])
  @@index([zoneId])
  @@map("vendor_profiles")
}

model VendorCategory {
  id         String  @id @default(uuid())
  profileId  String
  categoryId String
  isPrimary  Boolean @default(false)

  profile  VendorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id])

  @@unique([profileId, categoryId])
  @@map("vendor_categories")
}

model SocialLink {
  id        String         @id @default(uuid())
  profileId String
  platform  SocialPlatform
  url       String

  profile VendorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("social_links")
}

model Verification {
  id           String             @id @default(uuid())
  profileId    String
  ninLast4     String             @db.VarChar(4)
  status       VerificationStatus
  failedReason String?
  checkedAt    DateTime           @default(now())

  profile VendorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, checkedAt])
  @@map("verifications")
}

model Service {
  id          String  @id @default(uuid())
  profileId   String
  name        String
  priceMin    Int
  priceMax    Int?
  description String?

  profile VendorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("services")
}

model PortfolioImage {
  id        String @id @default(uuid())
  profileId String
  url       String
  sortOrder Int    @default(0)

  profile VendorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("portfolio_images")
}

model WorkingHours {
  id        String  @id @default(uuid())
  profileId String
  dayOfWeek Int
  openTime  String?
  closeTime String?
  isClosed  Boolean @default(false)

  profile VendorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayOfWeek])
  @@map("working_hours")
}
